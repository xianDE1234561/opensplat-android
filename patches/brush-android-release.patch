 }
 
+fn log_adapter(adapter: &Adapter, device: &Device) {
+    let info = adapter.get_info();
+    let limits = device.limits();
+    log::info!(
+        "Brush adapter: backend={:?} type={:?} name={:?} driver={:?} storage_buffers={} storage_binding_bytes={} workgroup_invocations={}",
+        info.backend,
+        info.device_type,
+        info.name,
+        info.driver,
+        limits.max_storage_buffers_per_shader_stage,
+        limits.max_storage_buffer_binding_size,
+        limits.max_compute_invocations_per_workgroup,
+    );
+}
+
+/// GFXStream reports conformance 0 even when compute subgroups are available.
+/// Only the explicitly built x86_64 Android test variant allows this adapter.
+#[cfg(all(feature = "emulator-vulkan", target_os = "android", target_arch = "x86_64"))]
+pub async fn burn_init_emulator() -> anyhow::Result<ProcessDevice> {
+    let instance = wgpu::Instance::new(wgpu::InstanceDescriptor {
+        backends: wgpu::Backends::VULKAN,
+        flags: wgpu::InstanceFlags::default()
+            | wgpu::InstanceFlags::ALLOW_UNDERLYING_NONCOMPLIANT_ADAPTER,
+        ..wgpu::InstanceDescriptor::new_without_display_handle()
+    });
+    let adapter = instance
+        .enumerate_adapters(wgpu::Backends::VULKAN)
+        .await
+        .into_iter()
+        .find(|adapter| adapter.get_info().name.starts_with("Goldfish GFXStream"))
+        .ok_or_else(|| anyhow::anyhow!("No GFXStream Vulkan adapter available"))?;
+    let features = adapter.features();
+    anyhow::ensure!(features.contains(wgpu::Features::SUBGROUP), "GFXStream Vulkan lacks compute subgroups");
+    let (device, queue) = adapter.request_device(&wgpu::DeviceDescriptor {
+        required_features: features.difference(wgpu::Features::MAPPABLE_PRIMARY_BUFFERS),
+        required_limits: adapter.limits(),
+        memory_hints: wgpu::MemoryHints::MemoryUsage,
+        ..Default::default()
+    }).await?;
+    log_adapter(&adapter, &device);
+    Ok(burn_wgpu::init_device(burn_wgpu::WgpuSetup {
+        instance, adapter, device, queue, backend: wgpu::Backend::Vulkan,
+    }, burn_options()).into())
+}
