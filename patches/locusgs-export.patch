+# The fused CUDA extension is only used by the training SSIM loss. Inference
+# (forward + gsplat render) must not require it, so the import is optional and
+# fails at call time instead of at module import time. See INTEGRATION_AUDIT.md.
+_FUSED_SSIM_IMPORT_ERROR: Exception | None = None
+try:
+    if torch.cuda.is_available():
+        from fused_ssim_cuda import fusedssim, fusedssim_backward
+    elif torch.mps.is_available():
+        from fused_ssim_mps import fusedssim, fusedssim_backward
+    elif hasattr(torch, 'xpu') and torch.xpu.is_available():
+        from fused_ssim_xpu import fusedssim, fusedssim_backward
+    else:
+        raise ImportError("no fused SSIM backend available")
+except Exception as _exc:  # pragma: no cover - depends on optional build
+    _FUSED_SSIM_IMPORT_ERROR = _exc
+
+    def fusedssim(*args, **kwargs):
+        raise RuntimeError(
+            "fused_ssim is unavailable in this environment "
+            f"({_FUSED_SSIM_IMPORT_ERROR}); install fused-ssim to use SSIM training loss"
+        )
+
+    fusedssim_backward = fusedssim
 
 
